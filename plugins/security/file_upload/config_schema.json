{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "File Upload Plugin Configuration",
  "type": "object",
  "properties": {
    "request_timeout": {
      "type": "integer",
      "minimum": 1,
      "maximum": 300,
      "default": 60,
      "description": "Request timeout in seconds (longer for file uploads)"
    },
    "max_concurrent_requests": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20,
      "default": 5,
      "description": "Maximum concurrent requests"
    },
    "user_agent": {
      "type": "string",
      "default": "open-re-file-upload-scanner/1.0",
      "description": "User agent string"
    },
    "follow_redirects": {
      "type": "boolean",
      "default": true,
      "description": "Follow HTTP redirects"
    },
    "max_redirects": {
      "type": "integer",
      "minimum": 0,
      "maximum": 20,
      "default": 10,
      "description": "Maximum redirect depth"
    },
    "verify_ssl": {
      "type": "boolean",
      "default": true,
      "description": "Verify SSL certificates"
    }
  },
  "required": [
    "request_timeout",
    "max_concurrent_requests",
    "user_agent",
    "follow_redirects",
    "max_redirects",
    "verify_ssl"
  ]
}